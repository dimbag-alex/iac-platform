# Подключение к zVirt Engine (ОБЯЗАТЕЛЬНО для интеграции с гипервизором)
# URL Менеджера управления (без завершающего слэша)
ZVIRT_URL=https://zhost.lab.loc
# Учётная запись вида user@realm; в zVirt 5.0 (Keycloak) realm — internalsso
ZVIRT_USERNAME=admin@zvirt@internalsso
ZVIRT_PASSWORD=changeme
# Проверка TLS-сертификата Engine (на стенде с самоподписанным — false)
ZVIRT_VERIFY_TLS=false
# Таймаут HTTP-запросов к Engine, секунды
ZVIRT_TIMEOUT=30

# Настройки приложения (ОПЦИОНАЛЬНО)
IAC_DEBUG=false
